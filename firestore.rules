rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================= helpers =================
    //
    // Modelo: professores APROVADOS compartilham alunos, rampas e biblioteca.
    // Nao ha isolamento por teacherId entre professores — isso era uma
    // exigencia antiga que o produto nao quer mais. O que existe e:
    //   1) professor novo nasce approval='pending' e nao acessa nada;
    //   2) so o admin pode aprovar (users/{uid}.approval);
    //   3) configuracoes pessoais (teachers/{uid}) continuam só do dono/admin;
    //   4) aluno so acessa o proprio vinculo.

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function myRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : null;
    }

    // Contas antigas nao tinham o campo: ausencia vale 'approved'.
    function myApproval() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approval', 'approved')
        : null;
    }

    function isTeacher() {
      return myRole() == 'teacher';
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function canTeach() {
      return isAdmin() || (isTeacher() && myApproval() == 'approved');
    }

    function onlyKeysChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(keys);
    }

    // Acesso null-safe a campos opcionais.
    function field(data, key) {
      return data.get(key, null);
    }

    function createdByMe(data) {
      return canTeach() && field(data, 'teacherId') == request.auth.uid;
    }

    function isSelf(data) {
      return signedIn() && field(data, 'authUid') == request.auth.uid;
    }

    // Professores aprovados leem tudo; aluno le o que e dele.
    function readable(data) {
      return canTeach() || isSelf(data);
    }

    function isStudentById(sid) {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(sid))
        && get(/databases/$(database)/documents/students/$(sid)).data
             .get('authUid', null) == request.auth.uid;
    }

    // ================= auth / perfil =================

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;

      // O usuario nao pode se autoaprovar nem mudar o proprio papel.
      allow update: if (signedIn()
          && request.auth.uid == uid
          && onlyKeysChanged(['displayName', 'photoUrl', 'locale', 'onboardingStep', 'lastSeenAt']))
        || (isAdmin() && onlyKeysChanged(['approval', 'role']));

      allow delete: if false;
    }

    match /teachers/{tid} {
      // Qualquer professor aprovado pode consultar o colega; so o dono edita.
      allow read: if signedIn() && (request.auth.uid == tid || canTeach());
      allow create: if signedIn() && request.auth.uid == tid;
      allow update: if (signedIn() && request.auth.uid == tid) || isAdmin();
      allow delete: if false;
    }

    // ================= alunos =================

    match /students/{sid} {
      allow get: if readable(resource.data);

      // Compartilhado: a query filtrada por outro teacherId agora DEVE trazer
      // os alunos. O filtro existe para organizacao, nao para seguranca.
      allow list: if readable(resource.data);

      // Quem cria vira o responsavel original (proveniencia), mas todos os
      // professores aprovados podem ler e editar depois.
      allow create: if canTeach()
        && request.resource.data.teacherId == request.auth.uid;

      allow update: if (canTeach()
          && request.resource.data.get('teacherId', null) == resource.data.get('teacherId', null)
          && request.resource.data.get('authUid', null) == resource.data.get('authUid', null))
        || (isSelf(resource.data)
          && onlyKeysChanged(['name', 'lastActiveAt', 'notificationPrefs']));

      allow delete: if canTeach();
    }

    // ================= avaliacoes diagnosticas =================

    match /assessments/{aid} {
      allow read: if readable(resource.data);
      allow create: if canTeach()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if canTeach();
    }

    // ================= rampas =================

    match /ramps/{rid} {
      allow read: if readable(resource.data);
      allow create: if canTeach()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if canTeach();
    }

    match /rampSteps/{stepId} {
      allow read: if readable(resource.data);

      allow create: if canTeach()
        && request.resource.data.teacherId == request.auth.uid;

      allow delete: if canTeach();

      // Professor aprovado edita livre; aluno so toca progresso.
      allow update: if canTeach();
      allow update: if readable(resource.data)
        && onlyKeysChanged(['progress', 'startedAt']);
    }

    // ================= biblioteca =================

    match /contents/{cid} {
      // Biblioteca e da plataforma: qualquer professor aprovado ve e edita.
      // Aluno so ve publicado.
      allow read: if canTeach()
        || (myRole() == 'student' && resource.data.get('status', null) == 'published');

      allow create: if canTeach()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if canTeach();
      allow delete: if canTeach()
        && resource.data.get('status', null) == 'draft';
    }

    match /contentReports/{rid} {
      allow read: if canTeach();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ================= tarefas =================

    match /tasks/{tid} {
      allow read: if readable(resource.data);
      allow create: if canTeach()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if canTeach();
    }

    match /taskSubmissions/{subId} {
      allow read: if readable(resource.data);

      // Aluno cria a propria entrega.
      allow create: if isStudentById(request.resource.data.studentId);

      // Qualquer professor aprovado devolve nota/feedback.
      allow update: if canTeach();

      allow delete: if false;
    }

    // ================= sessoes =================

    match /sessions/{sessId} {
      allow read: if readable(resource.data);
      allow create: if canTeach()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if canTeach();
    }

    // ================= progresso: append-only =================

    match /progressEvents/{eid} {
      allow read: if readable(resource.data);
      allow create: if canTeach()
        && request.resource.data.createdBy != 'student';
      allow update, delete: if false;
    }

    // ================= banco de itens do diagnostico =================

    match /diagnosticItems/{itemId} {
      allow read: if canTeach();
      allow write: if isAdmin();
    }

    // ================= notificacoes =================

    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && onlyKeysChanged(['readAt']);
      allow create: if canTeach();
      allow delete: if signedIn() && resource.data.recipientId == request.auth.uid;
    }

    // ================= negado por padrao =================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
